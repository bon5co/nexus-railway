# Sonatype Nexus Repository Community Edition for Railway: one service, one volume at /nexus-data,
# admin password generated by the template, Jetty on the injected $PORT, JVM heap sized from the
# container's cgroup memory limit instead of the host's.
FROM sonatype/nexus3:3.97.3@sha256:4b9a0efb605808c15927c751107b3f3308ae306c4b22715c96bf9bbabbb0e736

USER root
RUN apk add --no-cache su-exec

COPY railway-entrypoint.sh /usr/local/bin/railway-entrypoint.sh
RUN chmod 0755 /usr/local/bin/railway-entrypoint.sh

EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/railway-entrypoint.sh"]
CMD ["/opt/sonatype/nexus/bin/nexus", "run"]
